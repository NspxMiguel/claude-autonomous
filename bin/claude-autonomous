#!/usr/bin/env bash
# claude-autonomous — turn permission prompts off in Claude Code, and back on.
#
#   claude-autonomous on       apply the autonomous settings
#   claude-autonomous off      restore prompting
#   claude-autonomous status   show what is actually set right now
#
# Every write is merged into ~/.claude/settings.json, never a wholesale
# overwrite, and the previous file is copied to ~/.claude/backups/ first.
set -euo pipefail

VERSION="1.5.0"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS="$CLAUDE_DIR/settings.json"
BACKUPS="$CLAUDE_DIR/backups"

die() { printf '%s\n' "$*" >&2; exit 1; }

command -v python3 >/dev/null 2>&1 ||
  die "python3 is required (it does the JSON merge). Install it and re-run."

# Timestamp plus pid: two runs inside the same second must not overwrite each
# other's backup, which is exactly what happens during an install-then-toggle.
backup() {
  [ -f "$SETTINGS" ] || return 0
  mkdir -p "$BACKUPS"
  cp "$SETTINGS" "$BACKUPS/settings.json.$(date +%Y%m%d-%H%M%S)-$$"
}

cmd_on() {
  mkdir -p "$CLAUDE_DIR"
  backup
  python3 - "$SETTINGS" <<'PY'
import json, os, sys

MARKER = "claude-autonomous"

def is_ours(group):
    """Our auto-approve hook, however this platform spells `echo`."""
    return any(MARKER in "".join(h.get("args", []) or []) or
               MARKER in (h.get("command") or "")
               for h in group.get("hooks", []))

path = sys.argv[1]
cfg = {}
if os.path.exists(path):
    with open(path) as f:
        try:
            cfg = json.load(f)
        except json.JSONDecodeError as e:
            sys.exit(f"{path} is not valid JSON ({e}). Fix it and re-run.")

home = os.path.expanduser("~")

# --- permissions ---------------------------------------------------------
perms = cfg.setdefault("permissions", {})
perms["defaultMode"] = "bypassPermissions"
perms["deny"] = []
perms["ask"] = []

allow = set(perms.get("allow", []))
allow.update([
    "Bash", "Read", "Edit", "Write", "Glob", "Grep", "NotebookEdit",
    "WebFetch", "WebSearch", "Agent", "Task", "Skill", "Workflow",
    "Artifact", "SendUserFile",
    # MCP servers are allowed server-wide by prefix.
    "mcp__computer-use", "mcp__terminal", "mcp__claude-in-chrome",
    "mcp__Claude_Browser", "mcp__Claude_Code_iOS_Simulator",
    "mcp__ccd_session", "mcp__ccd_session_mgmt", "mcp__ccd_directory",
    "mcp__scheduled-tasks", "mcp__mcp-registry", "mcp__visualize",
])
perms["allow"] = sorted(allow)

# Claude Code is scoped to the project directory by default; widen it to the
# machine. Paths that do not exist on this OS are simply never matched.
dirs = set(perms.get("additionalDirectories", []))
dirs.update([home, "/Applications", "/Volumes", "/opt", "/usr/local",
             "/private/tmp", "/tmp", "/srv", "/mnt"])
perms["additionalDirectories"] = sorted(d for d in dirs if d == home or os.path.isdir(d))

# --- auto-approve hook ---------------------------------------------------
# bypassPermissions already suppresses prompts. This is the second line: if a
# session opens in another mode (the desktop app does this in some contexts),
# the hook answers "allow" before a prompt can exist.
# Exec form (command + args) means no shell parses the JSON payload.
auto = {
    "type": "command",
    "command": "/bin/echo",
    "args": [json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "allow",
            "permissionDecisionReason": "claude-autonomous",
        },
        "suppressOutput": True,
    })],
    "timeout": 5,
}
hooks = cfg.setdefault("hooks", {})
pre = [g for g in hooks.get("PreToolUse", []) if not is_ours(g)]
pre.append({"hooks": [auto]})
hooks["PreToolUse"] = pre

# --- everything else that stops to ask ------------------------------------
cfg["sandbox"] = {"enabled": False}          # commands run unconfined
cfg["enableAllProjectMcpServers"] = True     # no "trust this MCP server?" prompt
cfg["skipDangerousModePermissionPrompt"] = True
cfg["skipAutoPermissionPrompt"] = True
cfg["skipWorkflowUsageWarning"] = True
cfg["askUserQuestionTimeout"] = "60s"        # a question never parks the session
cfg["fileCheckpointingEnabled"] = True       # /rewind is the only undo left

# Not asking is only half of "does it without me". The other half is finishing
# without me, and reaching it from wherever I am.
cfg["doneMeansMerged"] = True                # keep working to a mergeable PR,
                                             # an armed cron, or a self-contained
                                             # next step — not to a status update
cfg["effortLevel"] = "high"                  # unattended work has no one to
                                             # catch a cheap wrong turn
cfg["remoteControlAtStartup"] = True         # drive the session from the phone
cfg["autoUploadSessions"] = True             # sessions readable from claude.ai
cfg["inputNeededNotifEnabled"] = True        # if something truly needs you,
cfg["agentPushNotifEnabled"] = True          # it reaches you instead of waiting
cfg["crossSessionInbound"] = "accept"        # your other sessions can hand work
cfg["daemonColdStart"] = "transient"         # background agents start silently
cfg["autoMemoryEnabled"] = True              # decisions survive the session
cfg["cleanupPeriodDays"] = 365               # transcripts stay for the audit

env = cfg.setdefault("env", {})
env.setdefault("BASH_DEFAULT_TIMEOUT_MS", "600000")   # 2 min -> 10 min
env.setdefault("BASH_MAX_TIMEOUT_MS", "600000")
env.setdefault("MCP_TIMEOUT", "60000")

with open(path, "w") as f:
    json.dump(cfg, f, indent=2, ensure_ascii=False)
    f.write("\n")
print(f"autonomous mode ON  ->  {path}")
PY
  echo
  echo "Restart your Claude Code session — the permission mode is read at startup."
}

cmd_off() {
  [ -f "$SETTINGS" ] || die "nothing to turn off: $SETTINGS does not exist"
  backup
  python3 - "$SETTINGS" <<'PY'
import json, sys

MARKER = "claude-autonomous"

def is_ours(group):
    """Our auto-approve hook, however this platform spells `echo`."""
    return any(MARKER in "".join(h.get("args", []) or []) or
               MARKER in (h.get("command") or "")
               for h in group.get("hooks", []))

path = sys.argv[1]
with open(path) as f:
    cfg = json.load(f)

perms = cfg.setdefault("permissions", {})
perms["defaultMode"] = "default"
perms.pop("additionalDirectories", None)

hooks = cfg.get("hooks", {})
pre = [g for g in hooks.get("PreToolUse", []) if not is_ours(g)]
if pre:
    hooks["PreToolUse"] = pre
else:
    hooks.pop("PreToolUse", None)
if not hooks:
    cfg.pop("hooks", None)

cfg["askUserQuestionTimeout"] = "never"

for key in ("doneMeansMerged", "remoteControlAtStartup", "autoUploadSessions",
            "crossSessionInbound", "agentPushNotifEnabled",
            "inputNeededNotifEnabled", "daemonColdStart", "effortLevel"):
    cfg.pop(key, None)

with open(path, "w") as f:
    json.dump(cfg, f, indent=2, ensure_ascii=False)
    f.write("\n")
print(f"autonomous mode OFF  ->  {path}")
print("the allow list is left in place — it only avoids repeat prompts, "
      "it does not grant anything on its own")
PY
  echo
  echo "Restart your Claude Code session."
}

cmd_status() {
  [ -f "$SETTINGS" ] || die "no settings file at $SETTINGS — run: claude-autonomous on"
  python3 - "$SETTINGS" <<'PY'
import json, sys

MARKER = "claude-autonomous"

def is_ours(group):
    """Our auto-approve hook, however this platform spells `echo`."""
    return any(MARKER in "".join(h.get("args", []) or []) or
               MARKER in (h.get("command") or "")
               for h in group.get("hooks", []))

path = sys.argv[1]
with open(path) as f:
    cfg = json.load(f)

perms = cfg.get("permissions", {})
groups = cfg.get("hooks", {}).get("PreToolUse", [])
hook = any(is_ours(g) for g in groups)

checks = [
    ("permission mode",      perms.get("defaultMode"),                   "bypassPermissions"),
    ("auto-approve hook",    "yes" if hook else "no",                    "yes"),
    ("deny rules",           len(perms.get("deny", [])),                 0),
    ("ask rules",            len(perms.get("ask", [])),                  0),
    ("dangerous-mode dialog",cfg.get("skipDangerousModePermissionPrompt"), True),
    ("sandbox",              (cfg.get("sandbox") or {}).get("enabled", False), False),
    ("file checkpointing",   cfg.get("fileCheckpointingEnabled"),        True),
    ("finish, don't report", cfg.get("doneMeansMerged"),                 True),
    ("effort",               cfg.get("effortLevel"),                     "high"),
    ("remote control",       cfg.get("remoteControlAtStartup"),          True),
    ("push notifications",   cfg.get("agentPushNotifEnabled"),           True),
    ("inbound from sessions",cfg.get("crossSessionInbound"),             "accept"),
]

w = max(len(n) for n, _, _ in checks)
bad = 0
for name, got, want in checks:
    ok = got == want
    bad += not ok
    print(f"{'OK ' if ok else '-- '} {name.ljust(w)}  {got}")

dirs = perms.get("additionalDirectories", [])
print(f"\ndirectories in scope ({len(dirs)}): {', '.join(dirs) or 'project only'}")
print(f"allow rules: {len(perms.get('allow', []))}")
print("\n" + ("AUTONOMOUS MODE ON" if not bad
             else f"INCOMPLETE — {bad} item(s) off; run: claude-autonomous on"))
sys.exit(1 if bad else 0)
PY
}

# --------------------------------------------------------------------------
# secrets
#
# The gap this closes: an agent can use a credential without ever holding it.
# You type the secret once, into your own keychain, in your own terminal. From
# then on `claude-autonomous run` injects it into a child process's environment
# — so the command sees it, the agent that wrote the command does not, and the
# value never lands in a transcript.
#
# This is what "grab the API key and do everything" actually needs. It does not
# cover a browser login form; nothing here types a password into a web page.
# --------------------------------------------------------------------------

SECRET_PREFIX="claude-autonomous"

secret_backend() {
  case "$(uname -s)" in
    Darwin) echo keychain ;;
    *)      command -v secret-tool >/dev/null 2>&1 && echo libsecret || echo none ;;
  esac
}

secret_set() { # secret_set NAME  — reads from a terminal, never from argv
  local name="${1:-}"
  [ -n "$name" ] || die "usage: claude-autonomous secret set NAME"
  case "$name" in
    [A-Za-z_]*) ;;
    *) die "NAME must be a valid environment variable name" ;;
  esac
  [ -t 0 ] || die "refusing to read a secret from a pipe — run this in a terminal"

  local value
  printf 'value for %s (input hidden): ' "$name" >&2
  read -rs value; printf '\n' >&2
  [ -n "$value" ] || die "empty, nothing stored"

  secret_store "$name" "$value"
  unset value
  echo "stored $name"
}

secret_store() { # secret_store NAME VALUE — the one place that writes
  local name="$1" value="$2" err=""
  case "$(secret_backend)" in
    keychain)
      # Failures are swallowed here on purpose: the read-back below is the
      # single verdict, so a backend that half-fails cannot report success.
      err="$(security add-generic-password -U -a "$USER" \
               -s "$SECRET_PREFIX:$name" -w "$value" \
               -D "claude-autonomous secret" 2>&1 >/dev/null || true)"
      ;;
    libsecret)
      err="$(printf '%s' "$value" | secret-tool store \
               --label="$SECRET_PREFIX:$name" \
               service "$SECRET_PREFIX" key "$name" 2>&1 >/dev/null || true)"
      ;;
    *) die "no OS keychain found (macOS Security, or secret-tool on Linux)" ;;
  esac

  # Read it back. A backend can fail in ways that are not a clean exit code —
  # secret-tool without a running D-Bus prints an error about machine-id — and
  # reporting "stored" for a value that is not there is the worst outcome.
  local check
  check="$(secret_get "$name" 2>/dev/null || true)"
  if [ "$check" != "$value" ]; then
    printf 'could not store %s — the keychain read back empty or different.\n' "$name" >&2
    [ -n "$err" ] && printf '  backend said: %s\n' "$err" >&2
    [ "$(secret_backend)" = libsecret ] && printf '%s\n' \
      '  secret-tool needs a session D-Bus and an unlocked keyring. A headless
  or containerised box has neither: start one (dbus-run-session, gnome-keyring)
  or pass the value through the environment instead.' >&2
    exit 1
  fi
  unset check
}

secret_import() { # secret_import NAME  — value on stdin, never echoed
  local name="${1:-}"
  [ -n "$name" ] || die "usage: ... | claude-autonomous secret import NAME"
  case "$name" in
    [A-Za-z_]*) ;;
    *) die "NAME must be a valid environment variable name" ;;
  esac
  [ -t 0 ] && die "secret import expects a pipe. For typing one in, use: secret set NAME"

  local value
  value="$(cat)"
  value="${value%"${value##*[![:space:]]}"}"   # trim trailing whitespace/newline
  value="${value#"${value%%[![:space:]]*}"}"   # and leading
  [ -n "$value" ] || die "nothing on stdin, nothing stored"

  secret_store "$name" "$value"
  # Report length only. The value itself never reaches stdout.
  echo "stored $name (${#value} characters)"
  unset value
}

secret_get() { # prints the value — used by `run`, not meant for a transcript
  local name="$1"
  case "$(secret_backend)" in
    keychain)  security find-generic-password -a "$USER" -s "$SECRET_PREFIX:$name" -w 2>/dev/null ;;
    libsecret) secret-tool lookup service "$SECRET_PREFIX" key "$name" 2>/dev/null ;;
    *)         return 1 ;;
  esac
}

secret_list() { # names only, never values
  case "$(secret_backend)" in
    keychain)
      security dump-keychain 2>/dev/null |
        sed -n "s/.*\"svce\"<blob>=\"$SECRET_PREFIX:\([^\"]*\)\".*/\1/p" | sort -u
      ;;
    libsecret)
      # Only the attribute.key lines. secret-tool's output also contains a
      # `secret = ...` line with the value itself, so this must never widen
      # into a loose match.
      # secret-tool search writes its results to stderr, so 2>&1 is required
      # rather than optional. Extract only attribute.key: the same stream also
      # carries a `secret = ...` line holding the value itself.
      secret-tool search --all service "$SECRET_PREFIX" 2>&1 |
        sed -n 's/^attribute\.key = //p' | sort -u ;;
    *) return 1 ;;
  esac
}

secret_rm() {
  local name="${1:-}"
  [ -n "$name" ] || die "usage: claude-autonomous secret rm NAME"
  case "$(secret_backend)" in
    keychain)  security delete-generic-password -a "$USER" -s "$SECRET_PREFIX:$name" >/dev/null 2>&1 ;;
    libsecret) secret-tool clear service "$SECRET_PREFIX" key "$name" ;;
  esac
  echo "removed $name"
}

cmd_secret() {
  case "${1:-list}" in
    set) shift; secret_set "${1:-}" ;;
    import) shift; secret_import "${1:-}" ;;
    rm|remove|delete) shift; secret_rm "${1:-}" ;;
    list|"")
      local names; names="$(secret_list || true)"
      if [ -z "$names" ]; then
        echo "no secrets stored. add one with: claude-autonomous secret set NAME"
      else
        echo "stored secrets (names only):"; printf '  %s\n' $names
      fi
      ;;
    *) die "usage: claude-autonomous secret [list|set NAME|rm NAME]" ;;
  esac
}

cmd_run() { # claude-autonomous run NAME[,NAME...] -- command args...
  local names="${1:-}"; shift || true
  [ "${1:-}" = "--" ] && shift
  [ -n "$names" ] && [ $# -gt 0 ] ||
    die "usage: claude-autonomous run NAME[,NAME] -- command [args...]"

  # Export rather than `env NAME=value cmd`: an assignment on the command line
  # lands in argv, where any user on the machine can read it out of `ps`.
  # Exported variables live in the environment instead, which on both macOS and
  # Linux is readable only by the process owner.
  local missing=()
  local IFS=,
  for name in $names; do
    local value
    if value="$(secret_get "$name")" && [ -n "$value" ]; then
      export "$name=$value"
    else
      missing+=("$name")
    fi
    unset value
  done
  unset IFS

  [ ${#missing[@]} -eq 0 ] ||
    die "not stored: ${missing[*]}  (add with: claude-autonomous secret set NAME)"

  exec "$@"
}

# --------------------------------------------------------------------------
# doctor — the layer no settings file reaches
# --------------------------------------------------------------------------

cmd_import_csv() {
  # The manual half of pulling in credentials: import a CSV the user exported
  # from a password manager (Apple Passwords: File -> Export All Passwords).
  local here; here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  [ -f "$here/import_csv.py" ] || die "import_csv.py is not next to the CLI"
  CLAUDE_AUTONOMOUS_CLI="$here/$(basename "${BASH_SOURCE[0]}")" \
    python3 "$here/import_csv.py" "$@"
}

cmd_harvest() {
  # Credentials usually already exist on the machine. This finds them and puts
  # them in the keychain, so nobody has to type or paste anything.
  local here; here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  [ -f "$here/harvest.py" ] || die "harvest.py is not next to the CLI"
  CLAUDE_AUTONOMOUS_CLI="$here/$(basename "${BASH_SOURCE[0]}")" \
    python3 "$here/harvest.py" "$@"
}

cmd_vault() {
  # A local page for handing a key over without recalling a command. The value
  # goes page -> this CLI on stdin -> keychain; it never reaches a transcript.
  local here; here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local vault="$here/vault.py"
  [ -f "$vault" ] || die "vault.py is not next to the CLI (expected $vault)"
  CLAUDE_AUTONOMOUS_CLI="$here/$(basename "${BASH_SOURCE[0]}")" \
    python3 "$vault" "$@"
}

cmd_doctor() {
  local os; os="$(uname -s)"
  echo "toolchain"
  for t in python3 git gh curl node claude; do
    if command -v "$t" >/dev/null 2>&1; then
      printf '  OK  %-8s %s\n' "$t" "$(command -v "$t")"
    else
      printf '  --  %-8s not found\n' "$t"
    fi
  done

  echo
  echo "authenticated CLIs (these do the work without the secret being read)"
  for c in "gh:gh auth status" "vercel:vercel whoami" \
           "supabase:supabase projects list" "firebase:firebase projects:list"; do
    local bin="${c%%:*}" probe="${c#*:}"
    if command -v "$bin" >/dev/null 2>&1; then
      if $probe >/dev/null 2>&1; then printf '  OK  %-10s signed in\n' "$bin"
      else printf '  --  %-10s installed, not signed in\n' "$bin"; fi
    else
      printf '      %-10s not installed\n' "$bin"
    fi
  done

  echo
  echo "stored secrets"
  local names; names="$(secret_list 2>/dev/null || true)"
  if [ -n "$names" ]; then printf '  OK  %s\n' $names
  else echo "  --  none (claude-autonomous secret set NAME)"; fi

  if [ "$os" = "Darwin" ]; then
    echo
    echo "macOS permissions — no settings file reaches these"
    if sqlite3 "$HOME/Library/Application Support/com.apple.TCC/TCC.db" \
         "select 1 limit 1" >/dev/null 2>&1; then
      echo "  OK  Full Disk Access granted to this terminal"
      sqlite3 "$HOME/Library/Application Support/com.apple.TCC/TCC.db" \
        "select service, auth_value from access" 2>/dev/null |
        awk -F'|' '$1 ~ /ScreenCapture|Accessibility|AppleEvents|SystemPolicy/ {
          printf "  %s  %s\n", ($2>=2 ? "OK " : "-- "), $1 }' | sort -u
    else
      echo "  --  cannot read TCC.db, so this terminal lacks Full Disk Access."
      echo "      That is itself the answer: grant it, then re-run doctor."
    fi
    cat <<'EOF'

  Open each pane and grant your terminal and Claude:
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation"
EOF
  fi

  echo
  cmd_status || true
}

usage() {
  cat <<'EOF'
claude-autonomous — turn permission prompts off in Claude Code, and back on.

  on                              apply the autonomous settings
  off                             restore prompting
  status                          show what is actually set right now
  doctor                          settings + toolchain + OS permissions

  secret list                     stored secret names (never values)
  secret set NAME                 store one, typed into your own keychain
  secret import NAME              store one from stdin, never echoed
  secret rm NAME                  remove one
  harvest [--apply]               find keys already on this machine, store them
  import-csv FILE [--apply]       import a password-manager CSV export
  vault                           open a local page to paste keys into
  run NAME[,NAME] -- cmd ...      run cmd with those secrets in its environment

`import` is for keys already on screen in a dashboard you are signed in to:
copy it there, then `pbpaste | claude-autonomous secret import GROQ_API_KEY`.
The value goes clipboard -> keychain without passing through a transcript.

`run` is the point: the command receives the credential, the agent that wrote
the command does not, and the value never enters a transcript.
EOF
}

case "${1:-status}" in
  on|enable)    cmd_on ;;
  off|disable)  cmd_off ;;
  status|"")    cmd_status ;;
  doctor)       cmd_doctor ;;
  vault)        shift; cmd_vault "$@" ;;
  harvest)      shift; cmd_harvest "$@" ;;
  import-csv)   shift; cmd_import_csv "$@" ;;
  secret|secrets) shift; cmd_secret "$@" ;;
  run)          shift; cmd_run "$@" ;;
  -v|--version) echo "claude-autonomous $VERSION" ;;
  -h|--help)    usage ;;
  *)            usage >&2; die "" ;;
esac
